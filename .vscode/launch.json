      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Predict churn (data/churn.csv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["predict", "--input", "data/churn.csv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
