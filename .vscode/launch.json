{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Exploratory analysis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["eda"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
